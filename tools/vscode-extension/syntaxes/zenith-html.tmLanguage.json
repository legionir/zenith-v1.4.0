          }
        },
        {
          "name": "meta.attribute.zen-suspense.html",
          "match": "\\b(zen-suspense)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-transition.html",
          "match": "\\b(zen-transition)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.prop.html",
          "match": "\\b(prop:[a-zA-Z_]+)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        }
      ]
    },
    "zen-expressions": {
      "patterns": [
        {
          "name": "string.interpolated.zenith",
          "match": "(\\$[a-zA-Z_][a-zA-Z0-9_.\\[\\]]*)",
          "captures": {
            "1": { "name": "variable.other.zenith" }
          }
        }
      ]
    }
  },
  "scopeName": "text.html.zenith"
}
