          }
        },
        {
          "name": "meta.attribute.zen-html-trusted.html",
          "match": "\\b(zen-html-trusted)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-cloak.html",
          "match": "\\b(zen-cloak)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-fallback.html",
          "match": "\\b(zen-fallback)\\b",
          "captures": {
