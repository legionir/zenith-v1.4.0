{
  "name": "Zenith HTML",
  "patterns": [
    {
      "include": "#zen-directives"
    },
    {
      "include": "#zen-expressions"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "zen-directives": {
      "patterns": [
        {
          "name": "meta.attribute.zen-action.html",
          "match": "\\b(zen-action(?::[a-z.]+)?)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-text.html",
          "match": "\\b(zen-text)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-if.html",
          "match": "\\b(zen-if)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith.keyword.control" }
          }
        },
        {
          "name": "meta.attribute.zen-for.html",
          "match": "\\b(zen-for)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith.keyword.control" }
          }
        },
        {
          "name": "meta.attribute.zen-bind.html",
          "match": "\\b(zen-bind(?::[a-zA-Z-]+)?)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-model.html",
          "match": "\\b(zen-model)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-html.html",
          "match": "\\b(zen-html)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-fetch.html",
          "match": "\\b(zen-fetch)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-link.html",
          "match": "\\b(zen-link)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-key.html",
          "match": "\\b(zen-key)\\b",
