            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-permission.html",
          "match": "\\b(zen-permission)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-role.html",
          "match": "\\b(zen-role)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.zenith" }
          }
        },
        {
          "name": "meta.attribute.zen-error.html",
          "match": "\\b(zen-error)\\b",
          "captures": {
