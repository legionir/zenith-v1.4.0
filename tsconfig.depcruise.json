{
  // #49: dependency-cruiser must see REAL cross-package edges. Workspace imports
  // (`@zenith/state`) resolve through node_modules to dist/ — outside `includeOnly` — so the
  // layer rules never fired. Mapping them to sources makes every `@zenith/*` import an edge.
  "extends": "./tsconfig.eslint.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@zenith/errors/internal": ["packages/errors/src/internal.ts"],
      "@zenith/state/internal": ["packages/state/src/internal.ts"],
      "@zenith/ssr/internal": ["packages/ssr/src/internal.ts"],
      "@zenith/expressions/internal": ["packages/expressions/src/internal.ts"],
      "@zenith/ui/*": ["packages/ui/src/*.ts"],
      "@zenith/*": ["packages/*/src/index.ts"]
    }
  }
}
