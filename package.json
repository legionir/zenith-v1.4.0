{
  "private": true,
  "name": "zenith-monorepo",
  "version": "1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:types": "node scripts/build-types.mjs",
    "build:browser": "node scripts/build-browser-bundle.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck-all.mjs",
    "release": "node scripts/release.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "node scripts/publint-all.mjs",
    "size": "size-limit",
    "deps": "dependency-cruiser packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "size-limit": "^11.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
