{
  "private": true,
  "name": "zenith-monorepo",
  "version": "1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:types": "node scripts/build-types.mjs",
    "build:browser": "node scripts/build-browser-bundle.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck-all.mjs",
    "release": "node scripts/release.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "node scripts/publint-all.mjs",
    "size": "size-limit",
    "deps": "dependency-cruiser packages",
    "deps:unused": "node scripts/unused-zenith-deps.mjs",
    "peer-rule": "node scripts/peer-rule.mjs",
    "error-hygiene": "node scripts/error-hygiene.mjs",
    "cleanup-hygiene": "node scripts/cleanup-hygiene.mjs",
    "attribute-grammar": "node scripts/attribute-grammar.mjs",
    "traceability": "node scripts/check-traceability.mjs",
    "peer:single-instance": "node scripts/peer-single-instance.mjs",
    "new:package": "node scripts/new-package.mjs",
    "test:leak": "vitest run packages/runtime/test/memory-leak-harness.test.ts",
    "pack:audit": "node scripts/pack-audit.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:ci": "node scripts/benchmark-ci.mjs",
    "bench:record": "node scripts/bench.mjs --record --passes 3",
    "bench:doc": "node scripts/generate-benchmarks-doc.mjs",
    "bench:browser": "node scripts/bench-browser.mjs",
    "make:sbom": "node scripts/generate-sbom.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "dec:index": "node scripts/generate-dec-index.mjs",
    "check:dec-index": "node scripts/generate-dec-index.mjs --check",
    "docs:errors": "node scripts/generate-error-docs.mjs",
    "check:positional-config": "node scripts/positional-config-audit.mjs",
    "check:error-docs": "node scripts/check-error-docs.mjs",
    "check:docs-examples": "node scripts/check-docs-examples.mjs",
    "check:adr": "node scripts/check-adr.mjs",
    "docs:adr": "node scripts/check-adr.mjs --write",
    "check:architecture-graph": "node scripts/generate-architecture-graph.mjs --check",
    "check:bench-doc": "node scripts/generate-benchmarks-doc.mjs --check",
    "check:unique-exports": "node scripts/check-unique-export-names.mjs",
    "docs:architecture-graph": "node scripts/generate-architecture-graph.mjs",
    "prepare": "husky",
    "dts-parity": "node scripts/check-dts-js-parity.mjs",
    "deps:graph": "node scripts/dependency-graph.mjs",
    "attw": "node scripts/attw-all.mjs",
    "install-import": "node scripts/install-import-check.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@hpcc-js/wasm-graphviz": "^1.29.2",
    "@playwright/test": "^1.56.1",
    "@preact/signals-core": "^1.14.4",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/reactivity": "^3.5.44",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^16.10.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "size-limit": "^11.2.0",
    "solid-js": "^1.9.17",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.19"
  },
  "browserslist": [
    "Chrome >= 109",
    "Edge >= 109",
    "Firefox >= 115",
    "Safari >= 16.4",
    "iOS >= 16.4",
    "not dead"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --quiet",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "overrides": {
    "@arethetypeswrong/core": {
      "typescript": "$typescript"
    }
  }
}
