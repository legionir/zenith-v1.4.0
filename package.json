{
  "private": true,
  "name": "zenith-monorepo",
  "version": "1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:types": "node scripts/build-types.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck-all.mjs",
    "release": "node scripts/release.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
