{
  "name": "@zenith/data-table",
  "version": "1.4.0",
  "description": "Zenith framework — Advanced reactive data table with sorting, filtering, pagination, selection, and inline editing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "data-table",
    "table",
    "grid",
    "datagrid"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/state": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
