{
  "name": "@zenith/adapter-node",
  "version": "1.5.0",
  "description": "Node HTTP server, secure static assets and graceful request-owned SSR.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs adapter-node",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/adapter-node"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/main/packages/adapter-node",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/ssr": "1.4.0",
    "@zenith/errors": "1.4.0",
    "@zenith/shared": "1.5.0",
    "@zenith/logger": "1.5.0",
    "@zenith/runtime-core": "1.5.0",
    "@zenith/schema": "1.5.0"
  },
  "peerDependencies": {
    "jsdom": "^24.0.0"
  },
  "zenith": {
    "target": "node"
  }
}
