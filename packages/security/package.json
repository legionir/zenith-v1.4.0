{
  "name": "@zenith/security",
  "version": "1.4.0",
  "description": "Zenith framework — HTML Sanitizer and Security Layer (Phase 9). Protects against XSS, prototype pollution, and dangerous protocols.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "security",
    "sanitizer",
    "xss",
    "html",
    "framework"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.19"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "jsdom": "^25.0.0"
  }
}
