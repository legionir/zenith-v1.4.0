{
  "name": "@zenith/stateful",
  "version": "1.4.0",
  "description": "Zenith framework \u2014 Stateful Components (v0.6.0). High-level components that auto-manage loading/error/empty/success/offline/retry states: zen-resource-view, zen-action-button, zen-auth-view.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "stateful",
    "components",
    "resource",
    "auth",
    "action",
    "framework"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/stateful"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/actions": "1.4.0",
    "@zenith/auth": "1.4.0",
    "@zenith/errors": "1.4.0",
    "@zenith/logger": "1.5.0",
    "@zenith/resource": "1.4.0",
    "@zenith/runtime": "1.4.0"
  },
  "peerDependencies": {
    "@zenith/state": "^1.4.0"
  },
  "zenith": {
    "target": "browser"
  }
}
