{
  "name": "@zenith/resource",
  "version": "1.4.0",
  "description": "Zenith framework — Declarative CRUD Resource (Phase 3). TanStack Query but HTML-first: deduplication, stale cache, retry, optimistic updates.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "resource",
    "crud",
    "cache",
    "query",
    "framework"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/state": "1.4.0",
    "@zenith/expressions": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
