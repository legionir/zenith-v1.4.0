{
  "name": "@zenith/vite-plugin",
  "version": "1.4.0",
  "description": "Zenith framework \u2014 Vite Plugin for HMR and DevTools auto-injection (Phase 10).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "vite",
    "plugin",
    "hmr",
    "devtools",
    "framework",
    "compile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@zenith/state": "^1.4.0",
    "vite": "^6.4.4 || ^7.3.7"
  },
  "dependencies": {
    "@zenith/unplugin-zenith": "1.5.0"
  },
  "devDependencies": {
    "vite": "^6.4.4"
  },
  "zenith": {
    "target": "node"
  }
}
