{
  "name": "@zenith/vite-plugin",
  "version": "1.4.0",
  "description": "Zenith framework — Vite Plugin for HMR and DevTools auto-injection (Phase 10).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/test-compile.ts"
  },
  "keywords": [
    "zenith",
    "vite",
    "plugin",
    "hmr",
    "devtools",
    "framework",
    "compile"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@zenith/compiler": "1.4.0",
    "@zenith/expressions": "1.4.0",
    "@zenith/runtime": "1.4.0",
    "@zenith/security": "1.4.0",
    "@zenith/state": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "tsx": "^4.7.0"
  }
}
