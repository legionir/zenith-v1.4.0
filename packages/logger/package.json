{
  "name": "@zenith/logger",
  "version": "1.5.0",
  "description": "Zenith framework — L0 structured logger: createLogger/Logger & Disposable, levels (debug/info/warn/error/silent), child scopes, redact, consoleSink (JSON on server), bufferSink, beaconSink, warnOnce, deprecate (ZEN-DEPR once), broken-sink guard (ZEN-1091).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "logger",
    "diagnostics",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/logger"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/errors": "1.4.0",
    "@zenith/shared": "1.5.0"
  }
}
