{
  "name": "@zenith/components",
  "version": "1.4.0",
  "description": "Zenith framework — Component system (Phase 6). Light DOM custom components with props, slots, and prototype-based context inheritance.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "components",
    "slots",
    "props",
    "framework"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/expressions": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
