{
  "name": "@zenith/compiler",
  "version": "1.4.0",
  "description": "Zenith framework — Template Compiler (Phase 12). Pre-compiles HTML templates to optimized JavaScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/test-no-silent-drop.ts"
  },
  "keywords": ["zenith", "compiler", "template", "optimization"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@zenith/dependency-graph": "1.0.0",
    "@zenith/expressions": "1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "jsdom": "^24.0.0"
  }
}
