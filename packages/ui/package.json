{
  "name": "@zenith/ui",
  "version": "1.5.0",
  "description": "Accessible headless UI controllers and scoped directive plugin.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./position": {
      "types": "./dist/position.d.ts",
      "import": "./dist/position.js",
      "default": "./dist/position.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js",
      "default": "./dist/dialog.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js",
      "default": "./dist/popover.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js",
      "default": "./dist/tooltip.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js",
      "default": "./dist/tabs.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js",
      "default": "./dist/menu.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "import": "./dist/accordion.js",
      "default": "./dist/accordion.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "import": "./dist/combobox.js",
      "default": "./dist/combobox.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js",
      "default": "./dist/date-picker.js"
    },
    "./portal": {
      "types": "./dist/portal.d.ts",
      "import": "./dist/portal.js",
      "default": "./dist/portal.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs ui",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/main/packages/ui",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/shared": "1.5.0",
    "@zenith/a11y": "1.5.0",
    "@zenith/jalali": "1.5.0",
    "@zenith/transition": "1.4.0",
    "@zenith/errors": "1.4.0",
    "@zenith/expressions": "1.4.0",
    "@zenith/schema": "1.5.0"
  },
  "peerDependencies": {
    "@zenith/state": "^1.4.0",
    "@zenith/scheduler": "^1.4.0"
  },
  "zenith": {
    "target": "universal"
  }
}
