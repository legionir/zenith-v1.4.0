{
  "name": "@zenith/errors",
  "version": "1.4.0",
  "description": "Zenith framework — Error messages library with structured codes (ZEN-001 to ZEN-999), helpful suggestions, and test coverage.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "errors",
    "error-codes",
    "error-messages"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
