{
  "name": "@zenith/runtime",
  "version": "1.4.0",
  "description": "Zenith framework — DOM Runtime and directives (Phase 6). Connects Phase 1 (State), Phase 2 (Expressions), Phase 4 (Events & Actions), Phase 5 (Lists) and Phase 6 (Components) to the browser DOM.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --tsconfig tsconfig.test.json test/test.ts && tsx test/integration-test.ts",
    "demo": "tsx --tsconfig tsconfig.test.json test/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "runtime",
    "dom",
    "directives",
    "framework",
    "reactive"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/state": "1.4.0",
    "@zenith/expressions": "1.4.0",
    "@zenith/actions": "1.4.0",
    "@zenith/events": "1.4.0",
    "@zenith/components": "1.4.0",
    "@zenith/scheduler": "1.4.0",
    "@zenith/router": "1.4.0",
    "@zenith/data": "1.4.0",
    "@zenith/security": "1.4.0",
    "@zenith/devtools": "1.4.0",
    "@zenith/error-boundary": "1.4.0",
    "@zenith/transition": "1.4.0",
    "@zenith/resource": "1.4.0",
    "@zenith/suspense": "1.4.0",
    "@zenith/auth": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0",
    "@types/jsdom": "^21.1.6",
    "jsdom": "^24.0.0",
    "@zenith/permission": "1.4.0",
    "@zenith/store": "1.4.0",
    "@zenith/form": "1.4.0",
    "@zenith/i18n": "1.4.0"
  }
}
