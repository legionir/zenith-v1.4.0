{
  "name": "@zenith/language-server",
  "version": "1.4.0",
  "description": "Zenith framework — Language Server Protocol core (diagnostics, completion, hover, rename over stdio or in-process).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs language-server",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "lsp",
    "language-server",
    "tooling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "dependencies": {
    "@zenith/compiler": "1.4.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "zenith": {
    "target": "node"
  }
}
