{
  "name": "@zenith/data",
  "version": "1.4.0",
  "description": "Zenith framework — Declarative Data Fetching (Phase 8). zen-fetch directive with loading/error/success states and reactive URL.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "data",
    "fetch",
    "api",
    "reactive",
    "framework"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/state": "1.0.0",
    "@zenith/expressions": "1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
