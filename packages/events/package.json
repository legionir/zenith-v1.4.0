{
  "name": "@zenith/events",
  "version": "1.4.0",
  "description": "Zenith framework — Event Delegation engine (Phase 4). A single delegated listener per event type on document, with modifier parsing (prevent, stop, enter, escape, ...).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "events",
    "delegation",
    "modifiers",
    "framework"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/events"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/actions": "1.4.0",
    "@zenith/error-boundary": "1.4.0",
    "@zenith/expressions": "1.4.0",
    "@zenith/router": "1.4.0",
    "@zenith/scheduler": "1.4.0",
    "@zenith/state": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.4.0"
  }
}
