{
  "name": "@zenith/templates",
  "version": "1.5.0",
  "description": "Zenith framework — data-driven project templates (spa/ssr/pwa/dashboard/minimal) and scaffold engine.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs templates",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "templates",
    "scaffold",
    "tooling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/templates"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "zenith": {
    "target": "node"
  }
}
