{
  "name": "@zenith/cli",
  "version": "1.4.0",
  "description": "Zenith framework — CLI for scaffolding projects, components, pages, and actions (Phase 10).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zenith": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "tsx test/test-check.ts"
  },
  "keywords": [
    "zenith",
    "cli",
    "scaffold",
    "generator",
    "framework"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/expressions": "1.4.0",
    "@zenith/runtime": "1.4.0",
    "@zenith/state": "1.4.0",
    "@zenith/vite-plugin": "1.4.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0"
  }
}
