{
  "name": "@zenith/eslint-plugin",
  "version": "1.5.0",
  "description": "ESLint flat-config rules for Zenith public API contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs eslint-plugin",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "eslint",
    "contracts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/expressions": "1.4.0",
    "@zenith/schema": "1.5.0",
    "parse5": "^7.3.0"
  },
  "zenith": {
    "target": "node"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  }
}
