{
  "name": "@zenith/create-zenith",
  "version": "1.5.0",
  "description": "Zenith framework — standalone project scaffolder (create-zenith).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-zenith": "./dist/index.js"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs create-zenith",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "create",
    "scaffold",
    "generator",
    "tooling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/create-zenith"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "dependencies": {
    "@zenith/templates": "1.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "zenith": {
    "target": "node"
  }
}
