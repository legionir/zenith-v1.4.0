{
  "manifest_version": 3,
  "name": "Zenith DevTools",
  "version": "1.4.0",
  "description": "Developer tools for Zenith Framework — Signal Inspector, Timeline, Components, Effects, v1.0 Features (zen-static, Resource.destroy, cache stats, SSR stores), Graph Viewer.",
  "action": {
    "default_popup": "popup.html"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'"
  }
}
