{
  "name": "@zenith/testing-e2e",
  "version": "1.5.0",
  "description": "Playwright fixtures with explicit readiness, diagnostics and axe checks.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "testing",
    "playwright",
    "axe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/testing-e2e"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/errors": "1.4.0",
    "@zenith/schema": "1.5.0"
  },
  "zenith": {
    "target": "node",
    "entryTargets": {
      "./browser": "browser"
    }
  },
  "peerDependencies": {
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.13.0",
    "@zenith/runtime-core": "^1.5.0",
    "@zenith/state": "^1.4.0",
    "@zenith/scheduler": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@zenith/runtime-core": {
      "optional": true
    },
    "@zenith/state": {
      "optional": true
    },
    "@zenith/scheduler": {
      "optional": true
    }
  }
}
