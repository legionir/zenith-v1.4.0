{
  "name": "@zenith/form",
  "version": "1.4.0",
  "description": "Zenith framework \u2014 Form handling + validation engine (Phase 3). Signal-based form state with reactive validation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "form",
    "validation",
    "reactive"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/form"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/errors": "1.4.0",
    "@zenith/logger": "1.5.0",
    "@zenith/schema": "1.5.0",
    "@zenith/shared": "1.5.0"
  },
  "peerDependencies": {
    "@zenith/state": "^1.4.0"
  },
  "zenith": {
    "target": "universal"
  }
}
