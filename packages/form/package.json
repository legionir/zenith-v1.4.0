{
  "name": "@zenith/form",
  "version": "1.4.0",
  "description": "Zenith framework — Form handling + validation engine (Phase 3). Signal-based form state with reactive validation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/form-test.ts"
  },
  "keywords": [
    "zenith",
    "form",
    "validation",
    "reactive"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/state": "1.4.0"
  },
  "peerDependencies": {
    "@zenith/state": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0",
    "@zenith/scheduler": "1.4.0"
  }
}
