{
  "name": "@zenith/permission",
  "version": "1.4.0",
  "description": "Zenith framework — Authorization runtime (Phase 4). RBAC + permission-based access control with zen-permission and zen-role directives.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "permission",
    "authorization",
    "rbac",
    "roles",
    "guard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/permission"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/router": "1.4.0",
    "@zenith/security": "1.4.0",
    "@zenith/state": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "@zenith/scheduler": "1.4.0"
  }
}
