{
  "name": "@zenith/error-boundary",
  "version": "1.4.0",
  "description": "Zenith framework — Error Boundary and Global Error Handler (Phase 11). Catches runtime errors in directives and expressions, shows fallback UI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["zenith", "error", "boundary", "fallback", "framework"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@zenith/state": "1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
