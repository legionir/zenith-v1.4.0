{
  "name": "@zenith/crud",
  "version": "1.4.0",
  "description": "Zenith framework — CRUD UI Actions (Phase 3). Pre-built actions for create/read/update/delete operations with @zenith/resource.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "crud",
    "actions",
    "resource"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/actions": "1.4.0",
    "@zenith/permission": "1.4.0",
    "@zenith/resource": "1.4.0",
    "@zenith/runtime": "1.4.0",
    "@zenith/state": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
