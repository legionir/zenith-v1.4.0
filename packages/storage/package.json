{
  "name": "@zenith/storage",
  "version": "1.5.0",
  "description": "Zenith framework — L0 unified storage layer (SPEC §۲.۵): createStorage over local/session/memory/cookie/indexeddb drivers with TTL, versioning/migrate, cross-tab sync, sensitive mode, quota policies, storage signals (@zenith/storage/signal), persistStore and zen-persist attribute grammar.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signal": {
      "types": "./dist/signal.d.ts",
      "import": "./dist/signal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "storage",
    "localstorage",
    "indexeddb",
    "cookie"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/storage"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zenith/errors": "1.4.0",
    "@zenith/logger": "1.5.0",
    "@zenith/shared": "1.5.0"
  }
}
