{
  "name": "@zenith/router",
  "version": "1.4.0",
  "description": "Zenith framework — SPA Router with History API (Phase 8). Declarative route definitions, lazy-loaded pages, URL parameter extraction.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx test/router-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "router",
    "spa",
    "history",
    "navigation",
    "framework"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zenith/state": "1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0"
  }
}
