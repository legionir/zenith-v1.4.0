{
  "name": "@zenith/unplugin-zenith",
  "version": "1.5.0",
  "description": "Zenith framework — unified build plugin core (Vite/Rollup/Webpack/esbuild/Rspack) with shared compile and options.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js",
      "default": "./dist/rollup.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "default": "./dist/webpack.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js",
      "default": "./dist/esbuild.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "default": "./dist/rspack.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs unplugin-zenith",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zenith",
    "unplugin",
    "vite",
    "rollup",
    "webpack",
    "esbuild",
    "rspack",
    "tooling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionir/zenith-v1.4.0.git",
    "directory": "packages/unplugin-zenith"
  },
  "homepage": "https://github.com/legionir/zenith-v1.4.0/tree/audit/consolidated-report#readme",
  "bugs": {
    "url": "https://github.com/legionir/zenith-v1.4.0/issues"
  },
  "engines": {
    "node": ">=18.19"
  },
  "dependencies": {
    "@zenith/compiler": "1.4.0",
    "@zenith/errors": "1.4.0",
    "@zenith/expressions": "1.4.0",
    "@zenith/logger": "1.5.0",
    "@zenith/schema": "1.5.0",
    "unplugin": "^3.4.0"
  },
  "peerDependencies": {
    "vite": "^6.4.4 || ^7.3.7"
  },
  "devDependencies": {
    "vite": "^6.4.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "zenith": {
    "target": "node"
  }
}
