{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [],
  "references": [
    { "path": "./packages/state" },
    { "path": "./packages/scheduler" },
    { "path": "./packages/expressions" },
    { "path": "./packages/runtime" },
    { "path": "./packages/router" },
    { "path": "./packages/compiler" },
    { "path": "./packages/components" },
    { "path": "./packages/actions" },
    { "path": "./packages/auth" },
    { "path": "./packages/data" },
    { "path": "./packages/form" },
    { "path": "./packages/i18n" },
    { "path": "./packages/resource" },
    { "path": "./packages/ssr" },
    { "path": "./packages/devtools" },
    { "path": "./packages/store" },
    { "path": "./packages/events" },
    { "path": "./packages/error-boundary" },
    { "path": "./packages/errors" },
    { "path": "./packages/transition" },
    { "path": "./packages/virtual-list" },
    { "path": "./packages/suspense" },
    { "path": "./packages/crud" },
    { "path": "./packages/stateful" },
    { "path": "./packages/security" },
    { "path": "./packages/permission" },
    { "path": "./packages/service-worker" },
    { "path": "./packages/dependency-graph" },
    { "path": "./packages/vite-plugin" },
    { "path": "./packages/data-table" },
    { "path": "./packages/cli" }
  ]
}
